# Copy this file to `.env` and adjust as needed. Do NOT commit `.env`.

# --- App metadata ---
APP_NAME=Churn Predictor
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=127.0.0.1
PORT=5001

# --- Artifacts ---
MODEL_FILENAME=churn_model.joblib
DATASET_FILENAME=churn_dataset.csv

# --- ML ---
RANDOM_SEED=42
TEST_SIZE=0.2

# --- Risk bucketing (probability thresholds) ---
HIGH_RISK_THRESHOLD=0.66
MEDIUM_RISK_THRESHOLD=0.33

# --- Logging ---
LOG_LEVEL=INFO
